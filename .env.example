# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: protect the /api/* endpoints. When set, every request must send
# "Authorization: Bearer <key>". Enter the same key in Studio → Settings.
# REELFORGE_API_KEY=

# Optional: import competitor ads from Meta's Ad Library (Studio → Competitors).
# A Meta access token from an account confirmed for Ad Library API access.
# Meta only returns commercial ads that were delivered in the EU.
# META_AD_LIBRARY_TOKEN=
# META_GRAPH_VERSION=v23.0
